{
  "templates": {
    "chop_trees": {
      "mode": "woodcutting",
      "repeat": true,
      "requires": [
        {"skill": {"id": "woodcutting", "min": "$level"}}
      ],
      "setup": [],
      "produces": ["logs", "woodcutting"],
      "actions": [
        {"type": "equipTool", "tool": "axe"},
        {
          "type": "interactObject",
          "catalog": "tree",
          "tier": "$tier",
          "option": "Chop down",
          "until": {"inventoryFull": true},
          "stallSeconds": 120
        },
        {
          "type": "choose",
          "options": [
            {"weight": 2, "actions": [{"type": "bank"}]},
            {"weight": 1, "actions": [{"type": "dropItems", "itemIds": "$resources"}]},
            {"weight": 1, "actions": [{"type": "sellItems", "itemIds": "$resources"}]}
          ]
        }
      ]
    },
    "mine_rocks": {
      "mode": "mining",
      "repeat": true,
      "requires": [
        {"skill": {"id": "mining", "min": "$level"}}
      ],
      "setup": [],
      "actions": [
        {"type": "equipTool", "tool": "pickaxe"},
        {
          "type": "interactObject",
          "catalog": "rock",
          "tier": "$tier",
          "option": "Mine",
          "until": {"inventoryFull": true},
          "stallSeconds": 120
        },
        {
          "type": "choose",
          "options": [
            {"weight": 2, "actions": [{"type": "bank"}]},
            {"weight": 1, "actions": [{"type": "dropItems", "itemIds": "$resources"}]},
            {"weight": 1, "actions": [{"type": "sellItems", "itemIds": "$resources"}]},
            {
              "weight": 1,
              "actions": [
                {"type": "smelt", "bar": "$bar"},
                {"type": "bank", "until": {"inventoryFull": false}}
              ]
            },
            {
              "weight": 1,
              "actions": [
                {"type": "smelt", "bar": "$bar"},
                {"type": "sellItems", "itemIds": "$smelted"}
              ]
            },
            {
              "weight": 1,
              "actions": [
                {"type": "smelt", "bar": "$bar"},
                {"type": "dropItems", "itemIds": "$smelted"}
              ]
            }
          ]
        }
      ]
    },
    "burn_logs": {
      "mode": "firemaking",
      "repeat": true,
      "requires": [
        {"skill": {"id": "firemaking", "min": "$level"}}
      ],
      "setup": [],
      "actions": [
        {"type": "ensureItem", "item": "tinderbox"},
        {"type": "bank", "withdraw": [{"item": "$log", "amount": "$logs"}]},
        {"type": "lightFire"}
      ]
    },
    "smelt_bar": {
      "mode": "smelting",
      "repeat": true,
      "requires": [
        {"skill": {"id": "smithing", "min": "$level"}}
      ],
      "setup": [],
      "actions": [
        {
          "type": "bank",
          "withdraw": [
            {"item": "$ore1", "amount": "$oreAmount"},
            {"item": "$ore2", "amount": "$oreAmount"}
          ]
        },
        {"type": "smelt", "bar": "$bar"},
        {"type": "bank", "until": {"inventoryFull": false}}
      ]
    }
  },
  "resolvers": [
    {
      "id": "withdraw_axe",
      "resolves": "item:axe",
      "actions": [
        {"type": "bank", "withdraw": [{"item": "bronze_axe", "amount": 1}]}
      ]
    },
    {
      "id": "return_to_site",
      "resolves": "area",
      "actions": [
        {"type": "walkTo", "x": 3147, "y": 3230, "z": 0, "radius": 6}
      ]
    }
  ],
